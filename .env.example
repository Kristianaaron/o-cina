# O-cina Environment Configuration
# Copy to .env and fill in values

# Backend (preferred names — aliases also accepted by scripts)
DATABASE_URL=sqlite:///~/.o-cina/data/center.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-string
API_KEYS=
OC_DEBUG=false

# Server (scripts accept OC_*, O_CINA_*, or BACKEND_*)
OC_HOST=127.0.0.1
OC_PORT=8002

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ChromaDB (local persistent client — not the Docker chromadb service)
CHROMA_PERSIST_DIR=~/.o-cina/data/chroma
OCINA_LOG_DIR=~/.o-cina/logs

# Logging
LOG_LEVEL=INFO
